# Copy this file to .env and fill in the existing Supabase project values.
# Client configuration is bundled with the app and is not secret storage.
# Use only an anon or publishable key. Never use a service-role/secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
